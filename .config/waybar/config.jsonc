[
  {
    "layer": "top",
    "mode": "dock",
    "position": "bottom",
    "margin-left": 15,
    "margin-right": 15,
    "spacing": 0,
    "output": [
      "eDP-1"
    ],
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "backlight",
      "custom/separator",
      "pulseaudio",
      "custom/separator",
      "battery",
      "custom/separator",
      "clock",
      "custom/separator",
      "tray"
    ],
    "mpris": {
      "format": "{player_icon} {dynamic}",
      "format-paused": "{status_icon} <i>{dynamic}</i>",
      "player-icons": {
        "default": "▶",
        "mpv": "🎵"
      },
      "status-icons": {
        "paused": ""
      },
      "max-length": 1000,
      "ignored-players": [
        "firefox"
      ],
      "interval": 1
    },
    "custom/separator": {
      "format": ""
    },
    "hyprland/window": {
      "format": "{}",
      "rotate": 0,
      "separate-outputs": true,
      "max-length": 50,
      "icon-size": 13,
      "icon": true
    },
    "wlr/taskbar": {
      "format": "{icon}",
      "on-click": "activate",
      "on-click-right": "fullscreen",
      "icon-size": 13,
      "tooltip-format": "{title}"
    },
    "custom/playerctl": {
      "format": "<span>{}</span>",
      "return-type": "json",
      "max-length": 30,
      "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}}{{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
      "on-click-middle": "playerctl play-pause",
      "on-click": "playerctl previous",
      "on-click-right": "playerctl next",
      "format-icons": {
        "Playing": "<span foreground='#62b389'>󰝚</span>",
        "Paused": "<span foreground='#47423E'>󰝛</span>"
      }
    },
    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "format-alt": "{icon} <sub>{name}</sub>",
      "format": "{name}: {icon}",
      "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "",
        "default": "",
        "persistent": "",
        "special": ""
      }
    },
    "memory": {
      "interval": 5,
      "format": "󰍛 {}%",
      "max-length": 10
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    },
    "clock": {
      "format": "{:%I:%M %p}",
      "rotate": 0,
      "format-alt": "{:%R 󰃭 %d·%m·%y}",
      "tooltip-format": "<span>{calendar}</span>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "pulseaudio": {
      "format": "{icon}  {volume}",
      "rotate": 0,
      "format-muted": "婢",
      "on-click": "pavucontrol -t 3",
      "on-click-middle": "volumecontrol.sh -o m",
      "on-scroll-up": "volumecontrol.sh -o i",
      "on-scroll-down": "volumecontrol.sh -o d",
      "tooltip-format": "{icon} {desc} // {volume}%",
      "scroll-step": 5,
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
          "",
          "",
          ""
        ]
      }
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": {
        "charging": [
          "󰢜",
          "󰂆",
          "󰂇",
          "󰂈",
          "󰢝",
          "󰂉",
          "󰢞",
          "󰂊",
          "󰂋",
          "󰂅"
        ],
        "default": [
          "󰁺",
          "󰁻",
          "󰁼",
          "󰁽",
          "󰁾",
          "󰁿",
          "󰂀",
          "󰂁",
          "󰂂",
          "󰁹"
        ]
      },
      "format-full": "Charged ",
      "interval": 5,
      "states": {
        "warning": 20,
        "critical": 10
      },
      "tooltip": false
    },
    "backlight": {
      "interval": 2,
      "align": 0,
      "rotate": 0,
      "format": "{icon}  {percent}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "tooltip-format": "backlight {percent}%",
      "icon-size": 10,
      "on-scroll-up": "brightnessctl set 5%+",
      "on-scroll-down": "brightnessctl set 5%-",
      "smooth-scrolling-threshold": 1
    }
  },
  {
    "layer": "top",
    "mode": "dock",
    "position": "bottom",
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "output": [
      "HDMI-A-1"
    ],
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "idle_inhibitor",
      "custom/separator",
      "pulseaudio",
      "custom/separator",
      "battery",
      "custom/separator",
      "tray"
    ],
    "custom/separator": {
      "format": ""
    },
    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "format-alt": "{icon} <sub>{name}</sub>",
      "format": "{name}: {icon}",
      "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "default": "",
        "persistent": "",
        "special": ""
      }
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    },
    "clock": {
      "format-alt": "{:%a, %d · %b  %I:%M %p}",
      "format": "{:%I:%M %p}"
    },
    "pulseaudio": {
      "format": "{icon}  {volume}",
      "rotate": 0,
      "format-muted": "婢",
      "on-click": "pavucontrol -t 3",
      "on-click-middle": "volumecontrol.sh -o m",
      "on-scroll-up": "volumecontrol.sh -o i",
      "on-scroll-down": "volumecontrol.sh -o d",
      "tooltip-format": "{icon} {desc} // {volume}%",
      "scroll-step": 5,
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
          "",
          "",
          ""
        ]
      }
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "rotate": 0,
      "format-icons": {
        "activated": "󰥔",
        "deactivated": ""
      }
    },
    "battery": {
      "format": "{icon} {capacity}% ",
      "format-icons": {
        "charging": [
          "󰢜",
          "󰂆",
          "󰂇",
          "󰂈",
          "󰢝",
          "󰂉",
          "󰢞",
          "󰂊",
          "󰂋",
          "󰂅"
        ],
        "default": [
          "󰁺",
          "󰁻",
          "󰁼",
          "󰁽",
          "󰁾",
          "󰁿",
          "󰂀",
          "󰂁",
          "󰂂",
          "󰁹"
        ]
      },
      "format-full": "Charged ",
      "interval": 5,
      "states": {
        "warning": 20,
        "critical": 10
      },
      "tooltip": true
    }
  }
]
