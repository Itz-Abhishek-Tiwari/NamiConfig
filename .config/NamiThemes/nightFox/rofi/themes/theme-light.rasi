// Catppuccin Latte
* {
    background:     #eff1f5;  /* Dayfox background */  
    background-alt: #e2e2eb;  /* Dayfox alternate background */  
    foreground:     #4c4f69;  /* Dayfox foreground */  
    selected:       #7287fd;  /* Dayfox blue (selection) */  
    active:         #40a02b;  /* Dayfox green (active) */  
    urgent:         #d20f39;  /* Dayfox red (urgent) */  
}

