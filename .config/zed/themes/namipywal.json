                    },
                    "variable": {
                        "color": "#afc7ba"
                    }
                }
            }
        },
        {
            "name": "namipywal_light",
            "appearance": "light",
            "style": {
                "background": "#0A1D20",
                "editor.background": "#0A1D20",
                "editor.foreground": "#afc7ba",
                "editor.line_number": "#7a8b82",
                "editor.active_line_number": "#afc7ba",
                "terminal.background": "#0A1D20",
                "terminal.foreground": "#afc7ba",
                "syntax": {
                    "keyword": {
                        "color": "#526E59"
                    },
                    "function": {
                        "color": "#6D737B"
                    },
                    "string": {
                        "color": "#298C5F"
                    },
                    "number": {
                        "color": "#64A259"
                    },
                    "type": {
                        "color": "#609568"
                    },
                    "comment": {
                        "color": "#7a8b82"
                    },
                    "variable": {
                        "color": "#afc7ba"
                    }
                }
            }
        }
