                    },
                    "variable": {
                        "color": "#bfe6ea"
                    }
                }
            }
        },
        {
            "name": "namipywal_light",
            "appearance": "light",
            "style": {
                "background": "#060D15",
                "editor.background": "#060D15",
                "editor.foreground": "#bfe6ea",
                "editor.line_number": "#85a1a3",
                "editor.active_line_number": "#bfe6ea",
                "terminal.background": "#060D15",
                "terminal.foreground": "#bfe6ea",
                "syntax": {
                    "keyword": {
                        "color": "#4C946D"
                    },
                    "function": {
                        "color": "#4A6E8A"
                    },
                    "string": {
                        "color": "#997083"
                    },
                    "number": {
                        "color": "#569DA8"
                    },
                    "type": {
                        "color": "#66BEC8"
                    },
                    "comment": {
                        "color": "#85a1a3"
                    },
                    "variable": {
                        "color": "#bfe6ea"
                    }
                }
            }
        }
    ]
