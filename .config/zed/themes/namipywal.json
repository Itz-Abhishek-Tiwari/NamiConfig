{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "NamiPywal",
    "author": "Antigravity",
    "themes": [
        {
            "name": "namipywal_dark",
            "appearance": "dark",
            "style": {
                "background": "#0a0812",
                "editor.background": "#0a0812",
                "editor.foreground": "#e5cbbb",
                "editor.line_number": "#a08e82",
                "editor.active_line_number": "#e5cbbb",
                "terminal.background": "#0a0812",
                "terminal.foreground": "#e5cbbb",
                "syntax": {
                    "keyword": {
                        "color": "#82645A"
                    },
                    "function": {
                        "color": "#916F61"
                    },
                    "string": {
                        "color": "#A57E6C"
