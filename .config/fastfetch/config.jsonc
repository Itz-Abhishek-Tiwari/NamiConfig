{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "yellow"
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  󰣇 ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "  󰒋 ",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "  󰔚 ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "  󰏖 ",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  󱆃 ",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "  󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "  󰍛 ",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}